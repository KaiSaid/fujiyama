# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env
# Файл .env в git не попадает (см. .gitignore) — секреты остаются на сервере.

# --- Django ---
# Случайная строка 50+ символов; сгенерировать можно так:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=замените-на-случайную-строку
DJANGO_DEBUG=False
# Домены сайта через запятую. Для теста по голому IP впишите IP сервера.
DJANGO_ALLOWED_HOSTS=fujiyama-club.ru,www.fujiyama-club.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://fujiyama-club.ru,https://www.fujiyama-club.ru

# --- База данных ---
# На простом Windows-сервере оставьте SQLite (отдельная БД не нужна):
USE_SQLITE=True
# Для PostgreSQL (Docker/Amvera) закомментируйте строку выше и заполните:

# --- PostgreSQL (эти же переменные использует контейнер базы) ---
POSTGRES_DB=fujiyama_db
POSTGRES_USER=fujiyama
POSTGRES_PASSWORD=придумайте-надёжный-пароль
POSTGRES_PORT=5432
# POSTGRES_HOST внутри docker-compose всегда «db» (задан в compose).
# Раскомментируйте только если база живёт вне compose (например, управляемая БД хостинга):
# POSTGRES_HOST=адрес-вашей-базы

# --- Первый администратор (создаётся сам при первом запуске) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=придумайте-пароль-админа
DJANGO_SUPERUSER_EMAIL=admin@example.com

# --- Домен для автоматического HTTPS (Caddy) ---
# Укажите домен без https:// — сертификат выпустится сам.
# Для теста по IP оставьте пустым.
DOMAIN=fujiyama-club.ru
